RA/QLoRA finetuning for LLM using Tunix</a>\n","- <a href=\"https://keras.io/examples/keras_recipes/parameter_efficient_finetuning_of_gemma_with_lora_and_qlora/\">Parameter-efficient fine-tuning of Gemma with LoRA and QLoRA</a>\n","- <a href=\"https://keras.io/keras_hub/guides/hugging_face_keras_integration/\">Loading Hugging Face transformers checkpoints</a>\n","- <a href=\"https://keras.io/guides/int8_quantization_in_keras/\">8-bit integer quantisation in Keras</a>\n","- <a href=\"https://keras.io/examples/keras_recipes/float8_training_and_inference_with_transformer/\">Float8 training and inference with a simple transformer model</a>\n","- <a href=\"https://keras.io/keras_hub/guides/transformer_pretraining/\">Pretraining a transformer from scratch with KerasHub</a>\n","- <a href=\"https://keras.io/examples/vision/mnist_convnet/\">Simple MNIST convnet</a>\n","- <a href=\"https://keras.io/examples/vision/image_classification_from_scratch/\">Image classification from scratch using Keras 3</a>\n","- <a href=\"https://keras.io/keras_hub/guides/classification_with_keras_hub/\">Image classification with KerasHub</a>\n"]},{"cell_type":"code","source":["import cv2\n","import numpy as np\n","from google.colab.patches import cv2_imshow\n","\n","# Read image\n","img = cv2.imread('input.png')   # make sure file exists in Colab\n","img = cv2.resize(img, (600, 600))\n","output = img.copy()\n"],"metadata":{"id":"-7_Aa8LmOHIK","executionInfo":{"status":"ok","timestamp":1778439045317,"user_tz":-330,"elapsed":76,"user":{"displayName":"","userId":""}}},"execution_count":2,"outputs":[]},{"cell_type":"code","source":["\n","# Convert to HSV\n","hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)\n","\n","# -------- Color Ranges --------\n","lower_red1 = np.array([0, 120, 70])\n","upper_red1 = np.array([10, 255, 255])\n","lower_red2 = np.array([170, 120, 70])\n","upper_red2 = np.array([180, 255, 255])\n","\n","lower_green = np.array([36, 50, 70])\n","upper_green = np.array([89, 255, 255])\n","\n","lower_blue = np.array([90, 50, 70])\n","upper_blue = np.array([128, 255, 255])\n","\n","lower_yellow = np.array([20, 100, 100])\n","upper_yellow = np.array([35, 255, 255])"],"metadata":{"id":"1nyG7xf2OklB","executionInfo":{"status":"ok","timestamp":1778439056506,"user_tz":-330,"elapsed":23,"user":{"displayName":"","userId":""}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":["# -------- Shape Detection --------\n","def detect_shape(cnt):\n","    peri = cv2.arcLength(cnt, True)\n","    approx = cv2.approxPolyDP(cnt, 0.04 * peri, True)\n","\n","    if len(approx) == 3:\n","        return \"Triangle\"\n","    elif len(approx) == 4:\n","        return \"Rectangle\"\n","    else:\n","        return \"Circle\""],"metadata":{"id":"wXLAbdpQOmd2","executionInfo":{"status":"ok","timestamp":1778439065084,"user_tz":-330,"elapsed":3,"user":{"displayName":"","userId":""}}},"execution_count":4,"outputs":[]},{"cell_type":"code","source":[" #-------- Process Function --------\n","def detect(mask, color_name):\n","    kernel = np.ones((5, 5), np.uint8)\n","    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)\n","\n","    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n","\n","    for cnt in contours:\n","        if cv2.contourArea(cnt) > 700:\n","            shape = detect_shape(cnt)\n","            x, y, w, h = cv2.boundingRect(cnt)\n","\n","            cv2.drawContours(output, [cnt], -1, (0, 0, 0), 2)\n","            cv2.putText(output, color_name + \" \" + shape, (x, y-10),\n","                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 0), 2)"],"metadata":{"id":"MD5DQT2LOpDh","executionInfo":{"status":"ok","timestamp":1778439088149,"user_tz":-330,"elapsed":4,"user":{"displayName":"","userId":""}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["\n","# -------- Masks --------\n","mask_red = cv2.bitwise_or(\n","    cv2.inRange(hsv, lower_red1, upper_red1),\n","    cv2.inRange(hsv, lower_red2, upper_red2)\n",")\n","\n","mask_green = cv2.inRange(hsv, lower_green, upper_green)\n","mask_blue = cv2.inRange(hsv, lower_blue, upper_blue)\n","mask_yellow = cv2.inRange(hsv, lower_yellow, upper_yellow)\n","\n","# -------- Detection --------\n","detect(mask_red, \"Red\")\n","detect(mask_green, \"Green\")\n","detect(mask_blue, \"Blue\")\n","detect(mask_yellow, \"Yellow\")"],"metadata":{"id":"fHQAPSuiOw0O","executionInfo":{"status":"ok","timestamp":1778439113899,"user_tz":-330,"elapsed":85,"user":{"displayName":"","userId":""}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["# -------- Show Output (FIXED) --------\n","cv2_imshow(output)"],"metadata":{"id":"CBc_GLn5O1c1","executionInfo":{"status":"ok","timestamp":1778439120166,"user_tz":-330,"elapsed":1310,"user":{"displayName":"","userId":""}},"outputId":"8720d256-a73a-4c68-ec35-54d268732798","colab":{"base_uri":"https://localhost:8080/","height":617}},"execution_count":8,"outputs":[{"output_type":"display_data","data":{"text/plain":["<PIL.Image.Image image mode=RGB size=600x600>"],"image/png":"\n","image/jpeg":"\n"},"metadata":{}}]}],"metadata":{"colab":{"name":"Welcome to Colab","provenance":[{"file_id":"/v2/external/notebooks/intro.ipynb","timestamp":1778439143349}]},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}